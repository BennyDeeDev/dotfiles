{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:OPENCODE_MODEL_STRONG}",
  "small_model": "{env:OPENCODE_MODEL_CHEAP}",
  "default_agent": "orchestrator",
  "agent": {
    "orchestrator": {
      "model": "{env:OPENCODE_MODEL_STRONG}"
    },
    "writer": {
      "model": "{env:OPENCODE_MODEL_MID}"
    },
    "reader": {
      "model": "{env:OPENCODE_MODEL_CHEAP}"
    }
  },
  "permission": {
    "read": "allow",
    "edit": "ask",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "allow",
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "mv *": "ask",
      "cp *": "ask",
      "dd *": "ask",
      "mkfs*": "ask",
      "fdisk *": "ask",
      "umount *": "ask",
      "sudo *": "ask",
      "kill *": "ask",
      "killall *": "ask",
      "pkill *": "ask",
      "shutdown *": "ask",
      "reboot *": "ask",
      "poweroff *": "ask",
      "halt *": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "git reset *": "ask",
      "git clean *": "ask",
      "git rebase *": "ask",
      "git merge *": "ask",
      "git cherry-pick *": "ask",
      "git stash drop *": "ask",
      "git rm *": "ask",
      "git mv *": "ask",
      "gh pr merge *": "ask",
      "gh pr close *": "ask",
      "gh pr edit *": "ask",
      "gh pr review *": "ask",
      "gh pr ready *": "ask",
      "gh release delete *": "ask",
      "gh release edit *": "ask",
      "gh repo delete *": "ask",
      "gh repo edit *": "ask",
      "gh run cancel *": "ask",
      "gh run rerun *": "ask",
      "gh workflow enable *": "ask",
      "gh workflow disable *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "chgrp *": "ask",
      "shred *": "ask",
      "systemctl stop *": "ask",
      "systemctl disable *": "ask",
      "systemctl mask *": "ask",
      "iptables *": "ask",
      "nft *": "ask",
      "ufw *": "ask",
      "parted *": "ask",
      "wipefs *": "ask",
      "docker exec *": "ask",
      "docker run *": "ask",
      "kubectl delete *": "ask",
      "kubectl edit *": "ask",
      "kubectl apply *": "ask",
      "kubectl create *": "ask",
      "kubectl scale *": "ask",
      "kubectl rollout *": "ask",
      "kubectl exec *": "deny",
      "kubectl run *": "deny",
      "kubectl patch *": "ask",
      "kubectl replace *": "ask",
      "kubectl annotate *": "ask",
      "kubectl label *": "ask",
      "kubectl taint *": "ask",
      "kubectl cordon *": "ask",
      "kubectl drain *": "ask",
      "docker rm *": "ask",
      "docker rmi *": "ask",
      "docker stop *": "ask",
      "docker kill *": "ask",
      "docker network rm *": "ask",
      "docker volume rm *": "ask",
      "docker container prune *": "ask",
      "docker image prune *": "ask",
      "docker system prune *": "ask",
      "helm uninstall *": "ask",
      "helm delete *": "ask",
      "helm upgrade *": "ask",
      "helm install *": "ask",
      "helm rollback *": "ask",
      "flux delete *": "ask",
      "flux suspend *": "ask",
      "flux push *": "ask"
    }
  }
}